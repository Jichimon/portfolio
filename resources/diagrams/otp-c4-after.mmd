%%{init: {'flowchart': {'curve': 'linear'}}}%%
flowchart LR
  Client["Client Apps"]:::client

  subgraph Platform["Platform boundary — orchestrator + 3 focused services"]
    direction TB

    subgraph G1[" "]
      direction LR
      Orch["Orchestrator<br/>(channel routing + delivery records)"]:::internal
      DeliveryDB[("Delivery Records DB")]:::store
    end
    Orch --> DeliveryDB

    subgraph G2[" "]
      direction LR
      Verif["Verification<br/>(OTP generate · validate · audit)"]:::internal
      ChallengeStore[("Challenge Store<br/>TTL key-value")]:::store
    end
    Verif --> ChallengeStore

    subgraph G3[" "]
      direction LR
      Queue{{"Queue (SQS)"}}:::store
      PushL["Push Listener<br/>(queue consumer)"]:::internal
    end
    Queue --> PushL

    subgraph G4[" "]
      direction LR
      Contact["Contact Handler<br/>(device token registry)"]:::internal
      TokenDB[("Device Token DB")]:::store
    end
    Contact --> TokenDB

    Orch --> Verif
    Orch --> Queue
    PushL -->|"fetch device token"| Contact
  end

  Client --> Orch
  Client --> Contact

  PushL -->|"push notifications<br/>highest volume · ~10⁷/mo"| PushProv["Push Notification Provider"]:::external
  Orch -->|"email"| EmailProv["Email Provider"]:::external
  Orch -->|"messaging (SMS/WhatsApp)"| MsgProv["Messaging Provider"]:::external
  Verif -->|"message delivery only<br/>~10⁵/mo · generation/validation now in-house"| OtpVendor["OTP-as-a-Service Vendor"]:::external

  classDef client fill:#e8eef7,stroke:#4a6fa5,color:#1a2b42
  classDef internal fill:#fff4d6,stroke:#b8860b,color:#3d2e00
  classDef external fill:#f0f0f0,stroke:#666666,color:#222222
  classDef store fill:#e6f4ea,stroke:#2e7d32,color:#1b3a20
