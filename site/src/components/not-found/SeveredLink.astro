---
// The site's own hero vocabulary — strata that cannot move on the left, discrete
// nodes on the right — with the channel between them severed and the status code
// sitting in the gap where the connection should be: a link that does not connect,
// on a site about connecting things. Geometry, not information, so the whole block
// is aria-hidden and the two SVGs carry no accessible name.
interface Props {
  code: string;
}

const { code } = Astro.props;
---

<div class="severed-link" aria-hidden="true">
  <svg class="severed-link__side" viewBox="0 0 420 96" preserveAspectRatio="xMaxYMid meet" fill="none">
    <g fill="var(--color-ink-faint)">
      <rect x="10" y="12" width="230" height="9"/><rect x="10" y="29" width="230" height="9"/>
      <rect x="10" y="46" width="230" height="9"/><rect x="10" y="63" width="230" height="9"/>
      <rect x="10" y="80" width="230" height="9"/>
    </g>
    <line x1="252" y1="50" x2="392" y2="50" stroke="var(--color-accent-line)" stroke-width="1.6"/>
    <line x1="392" y1="42" x2="392" y2="58" stroke="var(--color-accent-line)" stroke-width="1.6"/>
  </svg>

  <span class="severed-link__code">{code}</span>

  <svg class="severed-link__side" viewBox="0 0 420 96" preserveAspectRatio="xMinYMid meet" fill="none">
    <line x1="28" y1="50" x2="168" y2="50" stroke="var(--color-accent-line)" stroke-width="1.6"/>
    <line x1="28" y1="42" x2="28" y2="58" stroke="var(--color-accent-line)" stroke-width="1.6"/>
    <g stroke="var(--color-border-strong)" stroke-width="1.2">
      <line x1="186" y1="50" x2="256" y2="20"/><line x1="186" y1="50" x2="248" y2="70"/>
      <line x1="256" y1="20" x2="330" y2="38"/><line x1="248" y1="70" x2="322" y2="84"/>
      <line x1="330" y1="38" x2="400" y2="22"/><line x1="330" y1="38" x2="386" y2="66"/>
    </g>
    <g fill="none" stroke="var(--color-ink)" stroke-width="1.4">
      <circle cx="186" cy="50" r="6"/><circle cx="248" cy="70" r="5"/>
      <circle cx="322" cy="84" r="4"/><circle cx="400" cy="22" r="5"/>
    </g>
    <g fill="var(--color-accent)">
      <circle cx="256" cy="20" r="6"/><circle cx="330" cy="38" r="5"/><circle cx="386" cy="66" r="4"/>
    </g>
  </svg>
</div>

<style>
  .severed-link {
    display: flex;
    align-items: center;
    margin: 0 0 56px;
  }

  .severed-link__side {
    flex: 1 1 0;
    min-width: 0;
    height: 96px;
  }

  .severed-link__code {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 74px;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--color-accent);
    padding: 0 30px;
    flex: 0 0 auto;
  }

  @media (max-width: 1180px) {
    .severed-link__code {
      font-size: 60px;
      padding: 0 22px;
    }
  }

  @media (max-width: 820px) {
    .severed-link {
      margin-bottom: 40px;
    }
    .severed-link__side {
      height: 72px;
    }
    .severed-link__code {
      font-size: 54px;
      padding: 0 20px;
    }
  }

  /* Below this width the geometry has no room to read and would show as two
     smudges, so the sides go rather than shrink into noise — the status code
     carries the meaning alone. */
  @media (max-width: 560px) {
    .severed-link__side {
      display: none;
    }
    .severed-link {
      justify-content: flex-start;
    }
    .severed-link__code {
      padding: 0;
      font-size: 62px;
    }
  }
</style>
