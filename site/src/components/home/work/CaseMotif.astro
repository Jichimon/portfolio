---
interface Props {
  slug: string;
}

const { slug } = Astro.props;
---

{slug === 'mobile-banking-platform' && (
    <svg class="case-tile__motif" aria-hidden="true" viewBox="0 0 300 76" fill="none">
      <g fill="var(--color-ink-faint)">
        <rect x="0" y="8" width="86" height="7"/><rect x="0" y="21" width="86" height="7"/>
        <rect x="0" y="34" width="86" height="7"/><rect x="0" y="47" width="86" height="7"/>
        <rect x="0" y="60" width="86" height="7"/>
      </g>
      <line x1="104" y1="6" x2="104" y2="70" stroke="var(--color-accent-line)" stroke-width="1.5"/>
      <g stroke="var(--color-border-strong)" stroke-width="1.2">
        <line x1="122" y1="22" x2="180" y2="14"/><line x1="122" y1="22" x2="168" y2="48"/>
        <line x1="180" y1="14" x2="238" y2="32"/><line x1="168" y1="48" x2="226" y2="64"/>
        <line x1="238" y1="32" x2="290" y2="20"/>
      </g>
      <g fill="none" stroke="var(--color-ink)" stroke-width="1.4">
        <circle cx="122" cy="22" r="5"/><circle cx="168" cy="48" r="4"/>
        <circle cx="226" cy="64" r="4"/><circle cx="290" cy="20" r="4"/>
      </g>
      <g fill="var(--color-accent)"><circle cx="180" cy="14" r="5"/><circle cx="238" cy="32" r="4"/></g>
    </svg>
)}

{slug === 'qr-collections-for-merchants' && (
    <svg class="case-tile__motif" aria-hidden="true" viewBox="0 0 170 64" fill="none">
      <g stroke="var(--color-border-strong)" stroke-width="1.2">
        <line x1="26" y1="32" x2="134" y2="10"/><line x1="26" y1="32" x2="134" y2="25"/>
        <line x1="26" y1="32" x2="134" y2="40"/><line x1="26" y1="32" x2="134" y2="55"/>
      </g>
      <circle cx="26" cy="32" r="9" fill="var(--color-accent)"/>
      <g fill="none" stroke="var(--color-ink)" stroke-width="1.3">
        <circle cx="140" cy="10" r="5"/><circle cx="140" cy="25" r="5"/>
        <circle cx="140" cy="40" r="5"/><circle cx="140" cy="55" r="5"/>
      </g>
    </svg>
)}

{slug === 'otp-provider-decoupling' && (
    <svg class="case-tile__motif" aria-hidden="true" viewBox="0 0 170 64" fill="none">
      <rect x="2" y="14" width="50" height="36" rx="2" fill="none" stroke="var(--color-ink)" stroke-width="1.4"/>
      <g stroke="var(--color-border-strong)" stroke-width="1.2">
        <line x1="52" y1="24" x2="98" y2="12"/><line x1="52" y1="32" x2="98" y2="32"/>
        <line x1="52" y1="40" x2="98" y2="52"/>
      </g>
      <g fill="none" stroke="var(--color-ink)" stroke-width="1.3">
        <rect x="98" y="4" width="30" height="16" rx="2"/><rect x="98" y="24" width="30" height="16" rx="2"/>
      </g>
      <rect x="98" y="44" width="30" height="16" rx="2" fill="var(--color-accent-soft)" stroke="var(--color-accent)" stroke-width="1.4"/>
      <line x1="134" y1="52" x2="166" y2="52" stroke="var(--color-accent-line)" stroke-width="1.2" stroke-dasharray="3 3"/>
    </svg>
)}

{slug === 'legacy-payment-data-migration' && (
    <svg class="case-tile__motif" aria-hidden="true" viewBox="0 0 190 64" fill="none">
      <g fill="var(--color-ink-faint)">
        <rect x="2" y="10" width="46" height="6"/><rect x="2" y="22" width="46" height="6"/>
        <rect x="2" y="34" width="46" height="6"/><rect x="2" y="46" width="46" height="6"/>
      </g>
      <line x1="62" y1="32" x2="112" y2="32" stroke="var(--color-accent)" stroke-width="1.5"/>
      <polygon points="120,32 109,26 109,38" fill="var(--color-accent)"/>
      <g fill="none" stroke="var(--color-ink)" stroke-width="1.2">
        <rect x="134" y="10" width="52" height="6"/><rect x="134" y="22" width="52" height="6"/>
        <rect x="134" y="34" width="52" height="6"/><rect x="134" y="46" width="52" height="6"/>
      </g>
    </svg>
)}

{slug === 'multi-tenant-biometric-attendance' && (
    <svg class="case-tile__motif" aria-hidden="true" viewBox="0 0 170 64" fill="none">
      <g fill="none" stroke="var(--color-ink)" stroke-width="1.3">
        <rect x="2" y="4" width="26" height="12" rx="2"/><rect x="2" y="20" width="26" height="12" rx="2"/>
        <rect x="2" y="36" width="26" height="12" rx="2"/><rect x="2" y="52" width="26" height="10" rx="2"/>
      </g>
      <g stroke="var(--color-border-strong)" stroke-width="1.2">
        <line x1="28" y1="10" x2="92" y2="30"/><line x1="28" y1="26" x2="92" y2="31"/>
        <line x1="28" y1="42" x2="92" y2="33"/><line x1="28" y1="57" x2="92" y2="34"/>
      </g>
      <rect x="94" y="16" width="62" height="32" rx="2" fill="var(--color-accent-soft)" stroke="var(--color-accent)" stroke-width="1.4"/>
    </svg>
)}

<style>
  /* The motif is the element itself, not a wrapper around it — so a case study with
     no art of its own renders nothing at all, rather than an empty box holding a
     height and a margin. That is what lets a new case study land in the bento before
     anyone has drawn for it. */
  .case-tile__motif {
    display: block;
    height: 58px;
    width: auto;
    max-width: 100%;
    margin-bottom: 20px;
  }

  /* The two size rules belong to the tile shape, which the parent decides and this
     component only ever sits inside — hence the global ancestor and the scoped
     element. Keeping them here means every rule about this element is in one file. */
  :global(.case-tile--anchor) .case-tile__motif {
    height: 76px;
  }

  :global(.case-tile--full) .case-tile__motif {
    margin-bottom: 0;
    flex: 0 0 auto;
  }

  @media (max-width: 1180px) {
    :global(.case-tile--full) .case-tile__motif {
      margin-bottom: 8px;
    }
  }
</style>
