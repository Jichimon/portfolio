---
// The hero's background: a blurred stack of strata on the left, a fully resolved node
// graph on the right, and the two overlapping in the middle. The overlap IS the seam
// the whole site argues about — an explicit drawn line was tried in the design and
// kept reading as decoration, so the graph emerging out of the blur carries it instead.
// Purely decorative: the section that renders this marks it aria-hidden.
---

<div class="hero-backdrop__strata"></div>

<svg class="hero-backdrop__nodes" viewBox="0 0 900 560" preserveAspectRatio="xMidYMid slice" fill="none">
  <g stroke="var(--color-accent-line)" stroke-width="1.2">
      <line x1="120" y1="140" x2="320" y2="80"/>
      <line x1="120" y1="140" x2="80" y2="320"/>
      <line x1="360" y1="260" x2="560" y2="150"/>
      <line x1="360" y1="260" x2="180" y2="440"/>
      <line x1="560" y1="150" x2="760" y2="90"/>
      <line x1="680" y1="300" x2="820" y2="380"/>
      <line x1="480" y1="400" x2="650" y2="470"/>
      <line x1="650" y1="470" x2="850" y2="490"/>
      <line x1="820" y1="380" x2="850" y2="490"/>
      <line x1="760" y1="90" x2="870" y2="200"/>
      <line x1="560" y1="150" x2="650" y2="230"/>
      <line x1="650" y1="230" x2="800" y2="190"/>
      <line x1="800" y1="190" x2="900" y2="130"/>
      <line x1="870" y1="200" x2="900" y2="290"/>
      <line x1="820" y1="380" x2="760" y2="470"/>
      <line x1="760" y1="470" x2="650" y2="470"/>
      <line x1="850" y1="490" x2="900" y2="430"/>
      <line x1="680" y1="300" x2="800" y2="190"/>
      <line x1="480" y1="400" x2="620" y2="400"/>
      <line x1="620" y1="400" x2="720" y2="420"/>
      <line x1="720" y1="420" x2="820" y2="380"/>
      <line x1="620" y1="400" x2="650" y2="230"/>
      <line x1="820" y1="380" x2="860" y2="400"/>
      <line x1="860" y1="400" x2="900" y2="430"/>
      <line x1="650" y1="470" x2="600" y2="530"/>
      <line x1="600" y1="530" x2="740" y2="545"/>
      <line x1="740" y1="545" x2="760" y2="470"/>
      <line x1="740" y1="545" x2="870" y2="540"/>
      <line x1="870" y1="540" x2="850" y2="490"/>
      <line x1="870" y1="540" x2="900" y2="470"/>
      <line x1="480" y1="400" x2="440" y2="500"/>
      <line x1="440" y1="500" x2="600" y2="530"/>
  </g>
  <g fill="none" stroke="var(--color-ink)" stroke-width="1.4">
      <circle class="hero-backdrop__node" cx="120" cy="140" r="12"/>
      <circle class="hero-backdrop__node n3" cx="80" cy="320" r="9"/>
      <circle class="hero-backdrop__node n2" cx="360" cy="260" r="12"/>
      <circle class="hero-backdrop__node n4" cx="180" cy="440" r="8"/>
      <circle class="hero-backdrop__node n3" cx="480" cy="400" r="10"/>
      <circle class="hero-backdrop__node" cx="560" cy="150" r="7"/>
      <circle class="hero-backdrop__node n4" cx="820" cy="380" r="8"/>
      <circle class="hero-backdrop__node n2" cx="650" cy="470" r="9"/>
      <circle class="hero-backdrop__node n3" cx="870" cy="200" r="7"/>
      <circle class="hero-backdrop__node n2" cx="650" cy="230" r="8"/>
      <circle class="hero-backdrop__node n3" cx="800" cy="190" r="7"/>
      <circle class="hero-backdrop__node n4" cx="760" cy="470" r="7"/>
      <circle class="hero-backdrop__node n2" cx="900" cy="430" r="6"/>
      <circle class="hero-backdrop__node n3" cx="620" cy="400" r="8"/>
      <circle class="hero-backdrop__node n4" cx="860" cy="400" r="7"/>
      <circle class="hero-backdrop__node n2" cx="600" cy="530" r="8"/>
      <circle class="hero-backdrop__node n4" cx="870" cy="540" r="7"/>
      <circle class="hero-backdrop__node n3" cx="440" cy="500" r="7"/>
      <circle class="hero-backdrop__node n2" cx="900" cy="470" r="6"/>
  </g>
  <g fill="var(--color-accent)">
      <circle class="hero-backdrop__node n2" cx="320" cy="80" r="8"/>
      <circle class="hero-backdrop__node n4" cx="680" cy="300" r="9"/>
      <circle class="hero-backdrop__node n2" cx="760" cy="90" r="7"/>
      <circle class="hero-backdrop__node n4" cx="850" cy="490" r="8"/>
      <circle class="hero-backdrop__node n3" cx="900" cy="130" r="7"/>
      <circle class="hero-backdrop__node n2" cx="900" cy="290" r="8"/>
      <circle class="hero-backdrop__node n2" cx="720" cy="420" r="8"/>
      <circle class="hero-backdrop__node n4" cx="740" cy="545" r="9"/>
  </g>
</svg>

<div class="hero-backdrop__quiet"></div>

<style>
  /* Every fade finishes well INSIDE the element box. A fade that runs to the edge
     shows the edge instead of hiding it, which is what produced a vertical line
     that read as a border. */
  .hero-backdrop__strata {
    position: absolute;
    inset: 0;
    left: 0;
    width: 66%;
    background:
      repeating-linear-gradient(
        180deg,
        var(--color-ink-faint) 0px, var(--color-ink-faint) 26px,
        transparent 26px, transparent 34px
      ),
      repeating-linear-gradient(
        180deg,
        var(--color-accent-line) 0px, var(--color-accent-line) 3px,
        transparent 3px, transparent 34px
      );
    filter: blur(11px);
    opacity: 0.8;
    mask-image:
      linear-gradient(90deg, black 26%, transparent 84%),
      linear-gradient(180deg, transparent 0%, black 20%, black 72%, transparent 98%);
    mask-composite: intersect;
    animation: hero-strata-drift 14s ease-in-out infinite;
  }

  .hero-backdrop__nodes {
    position: absolute;
    inset: 0;
    right: 0;
    left: auto;
    width: 62%;
    opacity: 0.9;
    mask-image:
      linear-gradient(270deg, black 58%, transparent 97%),
      linear-gradient(180deg, transparent 0%, black 14%, black 90%, transparent 100%);
    mask-composite: intersect;
  }

  .hero-backdrop__node {
    animation: hero-node-drift 5s ease-in-out infinite;
  }
  .hero-backdrop__node.n2 { animation-delay: -1.2s; }
  .hero-backdrop__node.n3 { animation-delay: -2.6s; }
  .hero-backdrop__node.n4 { animation-delay: -3.6s; }

  /* A quiet zone directly behind the copy, so a rich background does not fight
     legibility. It is the reason the thesis stays readable over the strata. */
  .hero-backdrop__quiet {
    position: absolute;
    left: -8%;
    top: 32%;
    width: 66%;
    height: 60%;
    background: radial-gradient(ellipse, var(--color-bg) 0%, transparent 75%);
    z-index: 1;
    pointer-events: none;
  }

  @keyframes hero-strata-drift {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-2%); }
  }

  @keyframes hero-node-drift {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }

  @media (max-width: 820px) {
    .hero-backdrop__strata { width: 76%; }
    .hero-backdrop__nodes { width: 82%; opacity: 0.7; }
  }

  /* Two independent idle animations behind text is exactly what this setting exists
     to stop. The composition stays; only the motion goes. */
  @media (prefers-reduced-motion: reduce) {
    .hero-backdrop__strata,
    .hero-backdrop__node {
      animation: none;
    }
  }
</style>
