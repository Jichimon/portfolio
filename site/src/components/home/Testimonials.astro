---
import type { TestimonialCard } from '../../gateway/content-queries.ts';

interface Props {
  cards: TestimonialCard[];
}

const { cards } = Astro.props;
---

<ul class="testimonials">
  {cards.map((card) => (
    <li class="testimonial">
      <!--
        The opening quotation mark is decoration, not copy: it is generated by the stylesheet
        so no string has to exist for a character that carries nothing to translate, and it is
        hidden from assistive technology, which announces the blockquote already.
      -->
      <blockquote class="testimonial__quote">{card.quote}</blockquote>
      <p class="testimonial__name">{card.name}</p>
      <p class="testimonial__role">
        <span class="testimonial__title">{card.title}</span>
        <span class="testimonial__company">{card.company}</span>
      </p>
      <p class="testimonial__source">
        {card.translationNote !== undefined && (
          <span class="testimonial__translation">{card.translationNote}</span>
        )}
        <a class="testimonial__link" href={card.url}>{card.linkLabel}</a>
      </p>
    </li>
  ))}
</ul>

<style>
  .testimonials {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-auto-rows: min-content;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .testimonial {
    padding: 24px 22px;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    background: var(--color-bg-elevated);
  }

  /* An odd number of cards leaves the last one alone on its row, and a half-empty row reads
     as something missing rather than as a layout. So the last card takes the full width when
     the count is odd, and nothing spans when it is even — which is the same rule at one card
     (full width), three (two across, one below) and five, and needs no edit at two or four.
     Derived from the count rather than from a flag in the content: which recommendation reads
     last is the author's decision, how a leftover row is filled is not. */
  .testimonial:last-child:nth-child(odd) {
    grid-column: span 2;
  }

  .testimonial__quote {
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--color-ink-muted);
    margin: 0 0 18px;
    /* The quote is the card's own text, not an indented aside — the border and the padding
       already say where it starts, so the browser default margin would only misalign it. */
  }

  .testimonial__quote::before {
    content: '\201C';
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 32px;
    line-height: 1;
    color: var(--color-accent);
    margin-bottom: 12px;
  }

  .testimonial__name {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 13.5px;
    color: var(--color-ink);
    margin: 0;
  }

  .testimonial__role {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-label);
    margin: 3px 0 0;
  }

  .testimonial__source {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-ink-faint);
    margin: 10px 0 0;
  }

  /* Both separators are pseudo-elements for the reason the contact links already are:
     punctuation is not copy, it carries nothing to translate, and generating it means
     neither the role line nor the source line needs a separator string of its own. A card
     with no translation note renders one child here and no stray middle dot with it. */
  .testimonial__company::before,
  .testimonial__link:not(:first-child)::before {
    content: '\B7';
    color: var(--color-border-strong);
    margin: 0 6px;
  }

  .testimonial__link {
    color: inherit;
    text-decoration: none;
  }

  .testimonial__link:hover {
    color: var(--color-accent);
  }

  /* Below the narrow breakpoint the column is the page width, so two cards side by side
     leave neither of them readable, and with one track there is no second column for the
     last card to span into. */
  @media (max-width: 820px) {
    .testimonials {
      grid-template-columns: 1fr;
    }

    .testimonial:last-child:nth-child(odd) {
      grid-column: auto;
    }
  }
</style>
