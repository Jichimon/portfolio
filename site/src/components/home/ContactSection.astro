---
import { HONEYPOT_FIELD_NAME } from '../../../lib/contact/submission.mjs';

interface ContactLink {
  name: string;
  url: string;
}

interface Props {
  heading: string;
  invite: string;
  note: string;
  mailtoAddress: string;
  emailLabel: string;
  emailPlaceholder: string;
  aboutLabel: string;
  aboutPlaceholder: string;
  messageLabel: string;
  messagePlaceholder: string;
  submitLabel: string;
  sendingLabel: string;
  sentLabel: string;
  errorLabel: string;
  links: ContactLink[];
}

const {
  heading,
  invite,
  note,
  mailtoAddress,
  emailLabel,
  emailPlaceholder,
  aboutLabel,
  aboutPlaceholder,
  messageLabel,
  messagePlaceholder,
  submitLabel,
  sendingLabel,
  sentLabel,
  errorLabel,
  links,
} = Astro.props;
---

<section class="contact-section" id="contact">
  <div class="contact-section__layout">
  <div class="contact-section__main">
    <h2 class="contact-section__heading">{heading}</h2>
    <p class="contact-section__invite">{invite}</p>

    <!--
      The mailto action STAYS, and it is the fallback rather than the path. The submit
      listener intercepts and posts to the endpoint instead, so a visitor whose browser
      never ran the script still submits exactly as they did before any of this existed.
      An enhancement that replaces the action would turn a script failure into a dead form.

      The three result strings ride on data attributes because a bundled script cannot read
      this component's props. They are content and come from the strings collection; nothing
      here invents one.
    -->
    <form
      class="contact-section__form"
      action={`mailto:${mailtoAddress}`}
      method="post"
      data-sending={sendingLabel}
      data-sent={sentLabel}
      data-error={errorLabel}
      data-contact-address={mailtoAddress}
    >
      <div class="contact-section__field">
        <label class="contact-section__label" for="contact-section-email">{emailLabel}</label>
        <input
          class="contact-section__input"
          id="contact-section-email"
          name="email"
          type="email"
          placeholder={emailPlaceholder}
        />
      </div>
      <div class="contact-section__field">
        <label class="contact-section__label" for="contact-section-about">{aboutLabel}</label>
        <input
          class="contact-section__input"
          id="contact-section-about"
          name="about"
          type="text"
          placeholder={aboutPlaceholder}
        />
      </div>
      <div class="contact-section__field">
        <label class="contact-section__label" for="contact-section-message">{messageLabel}</label>
        <textarea
          class="contact-section__textarea"
          id="contact-section-message"
          name="message"
          placeholder={messagePlaceholder}
        ></textarea>
      </div>
      <!--
        The trap. Off-screen rather than display:none, because a bot that skips hidden
        fields is exactly the one worth catching; hidden from assistive technology and from
        the tab order, so nobody using either is ever offered it; and named nothing an
        autofill recognises, which is what stops a browser filling it in for a real person.
      -->
      <input
        class="contact-section__trap"
        name={HONEYPOT_FIELD_NAME}
        type="text"
        tabindex="-1"
        autocomplete="off"
        aria-hidden="true"
      />

      <button class="contact-section__submit" type="submit">{submitLabel}</button>

      <!--
        Empty until something happens, and announced when it does. role="status" is the
        polite channel: it reaches a screen reader without stealing focus from the form the
        visitor is still standing in.
      -->
      <p class="contact-section__status" role="status" aria-live="polite"></p>
    </form>

    <!--
      Runs after paint, and only on the page that carries this section — a component script
      ships with the component rather than with every route. The shape matches the one the
      layout already uses for the theme and the scroll tracking: a braced block around a
      dynamic import, so the module is fetched without blocking anything drawn above.
    -->
    <script>
      {
        import('../../behaviour/contact-form.mjs').then(function (contactForm) {
          var forms = document.querySelectorAll('.contact-section__form');

          forms.forEach(function (form) {
            // instanceof rather than a cast, and not only to narrow the type: a selector
            // that stops matching a form is a template change this would otherwise carry
            // into a runtime error on a page nobody was testing.
            if (!(form instanceof HTMLFormElement)) return;

            var statusElement = form.querySelector('.contact-section__status');
            if (!(statusElement instanceof HTMLElement)) return;

            form.addEventListener('submit', function (event) {
              event.preventDefault();
              contactForm.runContactSubmission({
                form: form,
                statusElement: statusElement,
                strings: {
                  sending: form.dataset.sending,
                  sent: form.dataset.sent,
                  error: form.dataset.error,
                },
                contactAddress: form.dataset.contactAddress,
                fetchImpl: window.fetch.bind(window),
              });
            });
          });
        });
      }
    </script>

    <div class="contact-section__footer">
      <p class="contact-section__note">{note}</p>
      <ul class="contact-section__links">
        {links.map((link) => (
          <li class="contact-section__link">
            <a href={link.url}>{link.name}</a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <!--
    The recommendations column, passed in rather than fetched here: this component knows
    the shape of the page, not where its content comes from. Nothing is rendered when the
    slot is empty, and the grid's first column keeps its own measure either way.
  -->
  <slot />
  </div>
</section>

<style>
  .contact-section {
    padding-top: 60px;
    padding-bottom: 60px;
  }

  /* Two columns: the form at its own measure, the recommendations beside it. The measure
     is declared on the track rather than on the form, so it holds whether or not anything
     sits next to it — a text input the full width of the page is nobody's idea of a form,
     and that was true while this column stood alone and stays true now. */
  .contact-section__layout {
    display: grid;
    grid-template-columns: minmax(0, 520px) 1fr;
    gap: 64px;
    align-items: start;
  }

  /* Below the medium breakpoint there is no room for two readable columns, so they stack
     and the recommendations follow the form rather than crowding it. */
  @media (max-width: 1180px) {
    .contact-section__layout {
      grid-template-columns: 1fr;
      gap: 44px;
    }
  }

  .contact-section__main {
    max-width: 520px;
  }

  .contact-section__heading {
    font: var(--type-display-m);
    /* The type tokens carry family, weight and size only — tokens.css states that
       letter spacing is a separate declaration wherever the design gives a figure,
       and this heading is one of the places it does. */
    letter-spacing: -0.008em;
    color: var(--color-ink);
    margin: 0 0 22px;
  }

  /* Literal, not a token: this step of the type ramp has no matching
     shorthand, so the size and line-height are named directly rather
     than borrowing a token that would silently change them. */
  .contact-section__invite {
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-ink-muted);
    margin: 0 0 32px;
  }

  .contact-section__form {
    margin: 0 0 36px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .contact-section__field {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .contact-section__label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--color-label);
  }

  .contact-section__input,
  .contact-section__textarea {
    width: 100%;
    box-sizing: border-box;
    font-family: var(--font-body);
    font-size: 14.5px;
    color: var(--color-ink);
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--color-border-strong);
    padding: 8px 2px;
    border-radius: 0;
  }

  .contact-section__input:focus,
  .contact-section__textarea:focus {
    outline: none;
    border-bottom-color: var(--color-accent);
  }

  .contact-section__textarea {
    min-height: 84px;
    resize: vertical;
    font-family: inherit;
  }

  .contact-section__submit {
    align-self: flex-start;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 14px;
    color: var(--color-bg);
    background: var(--color-ink);
    border: none;
    padding: 12px 28px;
    border-radius: 2px;
    cursor: pointer;
    transition: background 0.15s ease;
  }

  .contact-section__submit:hover {
    background: var(--color-accent);
  }

  .contact-section__submit:disabled {
    cursor: progress;
    opacity: 0.55;
  }

  /* Off-screen rather than hidden: a field with display:none or hidden is one a bot can
     cheaply learn to skip, and the whole value of the trap is that it gets filled. */
  .contact-section__trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  /* No height until it says something, so the layout below does not shift when it does. */
  .contact-section__status {
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.5;
    margin: -4px 0 0;
    color: var(--color-ink-muted);
    overflow-wrap: anywhere;
  }

  .contact-section__status:empty {
    display: none;
  }

  /* Three states, three weights of the SAME palette — no colour is introduced for this.
     Quiet while it is happening, plain once it worked, and the site's own accent when it
     did not, which is the one thing on the page that already means "look here". */
  .contact-section__status[data-state='sending'] {
    color: var(--color-ink-faint);
  }

  .contact-section__status[data-state='sent'] {
    color: var(--color-ink);
  }

  .contact-section__status[data-state='error'] {
    color: var(--color-accent);
  }

  .contact-section__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 14px;
    padding-top: 22px;
    border-top: 1px solid var(--color-border);
  }

  .contact-section__note {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--color-ink-faint);
    margin: 0;
  }

  /* The separator is a CSS pseudo-element rather than a text node, which is how the
     rail already draws the same row: punctuation is not copy, it carries no meaning
     to translate, and generating it means the list never needs a separator prop. */
  .contact-section__link:not(:first-child)::before {
    content: '·';
    color: var(--color-border-strong);
    margin-right: 14px;
  }

  .contact-section__links {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--color-ink-muted);
  }

  .contact-section__link a {
    color: inherit;
    text-decoration: none;
  }

  .contact-section__link a:hover {
    color: var(--color-accent);
  }
</style>
