---
// The platform's headline figure, where a case study carries an outcome metric. Both
// halves are printed exactly as the content carries them — the figure and its caption
// are two frontmatter keys, and neither is reformatted here.
interface Props {
  figure: string;
  caption?: string;
}

const { figure, caption } = Astro.props;
---

<div class="scale-block">
  <div class="scale-block__figure">{figure}</div>
  {caption && <div class="scale-block__caption">{caption}</div>}
</div>

<style>
  .scale-block {
    flex: 0 0 auto;
  }
  .scale-block__figure {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 46px;
    line-height: 1;
    color: var(--color-accent);
  }
  .scale-block__caption {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-label);
    margin-top: 8px;
    max-width: 200px;
  }

  @media (max-width: 820px) {
    .scale-block__figure {
      font-size: 34px;
    }
  }
</style>
