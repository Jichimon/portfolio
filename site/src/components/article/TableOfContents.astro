---
// The article's own headings, in the rail. It costs the article no horizontal space
// and stays visible for the whole read. `data-spy` is the contract the shared
// position tracker already implements: it marks the named class on the list item
// whose section is in view, so this file builds the list and tracks nothing itself.
interface TableOfContentsEntry {
  id: string;
  label: string;
}

interface Props {
  label: string;
  entries: TableOfContentsEntry[];
}

const { label, entries } = Astro.props;
const CURRENT_ITEM_CLASS = 'article-toc__item--current';
---

{
  entries.length > 0 && (
    <div class="article-toc" data-spy={CURRENT_ITEM_CLASS}>
      <div class="article-toc__label">{label}</div>
      <ol class="article-toc__list">
        {entries.map((entry) => (
          <li class="article-toc__item">
            <a class="article-toc__link" href={`#${entry.id}`}>
              {entry.label}
            </a>
          </li>
        ))}
      </ol>
    </div>
  )
}

<style>
  .article-toc {
    margin-top: 32px;
    padding-top: 20px;
    border-top: 1px solid var(--color-border);
  }
  .article-toc__label {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
    margin-bottom: 10px;
  }
  .article-toc__list {
    list-style: none;
    margin: 0;
    padding: 0 0 0 12px;
    border-left: 1px solid var(--color-border);
  }
  .article-toc__item {
    position: relative;
  }
  .article-toc__link {
    display: block;
    padding: 5px 0;
    font-family: var(--font-body);
    font-size: 12px;
    line-height: 1.35;
    color: var(--color-ink-faint);
    text-decoration: none;
    transition: color 0.14s ease;
  }
  .article-toc__link:hover {
    color: var(--color-ink);
  }
  .article-toc__link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-radius: 2px;
  }
  .article-toc__item--current .article-toc__link {
    color: var(--color-ink);
    font-weight: 600;
  }
  /* The accent segment beside the entry whose section is in view. Drawn on the item
     rather than the link so it sits against the list's own rule, not the text. */
  .article-toc__item--current::before {
    content: '';
    position: absolute;
    left: -13px;
    top: 4px;
    bottom: 4px;
    width: 1px;
    background: var(--color-accent);
  }

  /* The rail stops being a rail here, and a table of contents laid out sideways is
     worse than none: the artboard drops it at this width. */
  @media (max-width: 820px) {
    .article-toc {
      display: none;
    }
  }
</style>
