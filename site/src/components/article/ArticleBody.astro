---
// The rendered article, plus the styles for the markup the markdown pipeline emits.
// Those styles are global on purpose and it is the one thing in this file worth
// explaining: Astro scopes a component's CSS by stamping an attribute on the elements
// in its own template, and the elements below are emitted by the content pipeline, so
// they never receive it. Everything is prefixed with the block's own class instead,
// which contains the rules to this component's subtree rather than to the page.
interface Props {
  content: any;
}

const { content: Content } = Astro.props;
---

<div class="article-prose">
  <Content />
</div>

<style is:global>
  .article-prose {
    max-width: 700px;
  }
  .article-prose h2 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 24px;
    letter-spacing: -0.006em;
    margin: 56px 0 20px;
  }
  .article-prose > h2:first-child {
    margin-top: 0;
  }
  .article-prose h3 {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 17px;
    margin: 36px 0 14px;
  }
  .article-prose p {
    font-size: 16px;
    line-height: 1.72;
    color: var(--color-ink-muted);
    margin: 0 0 18px;
  }
  .article-prose ul,
  .article-prose ol {
    font-size: 16px;
    line-height: 1.68;
    color: var(--color-ink-muted);
    padding-left: 22px;
    margin: 0 0 20px;
  }
  .article-prose li {
    margin-bottom: 10px;
  }
  .article-prose li::marker {
    color: var(--color-accent);
    font-family: var(--font-mono);
  }
  .article-prose strong {
    color: var(--color-ink);
    font-weight: 650;
  }
  .article-prose a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* The diagram figure. The asset keeps its own baked-in light background, so the
     frame is drawn to match rather than left to clash with the page in dark mode —
     a decision that goes away when the assets themselves become theme-aware. */
  .article-prose .article-figure {
    margin: 44px 0;
  }
  .article-prose .article-figure img {
    display: block;
    width: 100%;
    height: auto;
    background: var(--color-diagram-surface);
    border: 1px solid var(--color-border);
    border-radius: 3px;
  }
  .article-prose .article-figure figcaption {
    font-family: var(--font-mono);
    font-size: 11.5px;
    line-height: 1.6;
    color: var(--color-ink-faint);
    margin-top: 14px;
    max-width: 760px;
  }

  /* The platform's services, as a grid rather than a bullet list. The list arrives
     already rebuilt by the pipeline; this only draws it. */
  .article-prose .service-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
    margin: 0 0 20px;
    padding: 0;
  }
  .article-prose .service-grid__item {
    border: 1px solid var(--color-border);
    border-radius: 3px;
    padding: 16px 18px;
    background: var(--color-bg-elevated);
  }
  .article-prose .service-grid__name {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 14.5px;
    margin-bottom: 6px;
    color: var(--color-ink);
  }
  .article-prose .service-grid__description {
    font-size: 13px;
    line-height: 1.5;
    color: var(--color-ink-muted);
  }

  /* The self-critique, in the panel the artboards give it. Selected positionally by
     the pipeline, never by its heading, because the two locales word it differently. */
  .article-prose .article-critique {
    max-width: 780px;
    margin: 56px 0 0;
    padding: 30px 32px;
    background: var(--color-accent-soft);
    border-radius: 3px;
  }
  .article-prose .article-critique h2 {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0 0 20px;
  }
  .article-prose .article-critique p {
    font-size: 15.5px;
    line-height: 1.68;
    margin: 0 0 20px;
  }
  .article-prose .article-critique p:last-child {
    margin-bottom: 0;
  }

  /* The anchor target lands below the top edge rather than flush against it. */
  .article-prose [id] {
    scroll-margin-top: 32px;
  }

  @media (max-width: 820px) {
    .article-prose {
      max-width: none;
    }
    .article-prose h2 {
      font-size: 21px;
    }
    .article-prose p,
    .article-prose ul,
    .article-prose ol {
      font-size: 15.5px;
    }
    .article-prose .service-grid {
      grid-template-columns: 1fr;
    }
    .article-prose .article-critique {
      padding: 22px 20px;
    }
    /* The container owns the overflow, never the image: the figure scrolls sideways
       and the page does not. A diagram shrunk to a phone's width is unreadable, so it
       keeps a legible minimum and the reader pans it. */
    .article-prose .article-figure {
      overflow-x: auto;
    }
    .article-prose .article-figure img {
      min-width: 620px;
    }
  }
</style>
