---
// One list, three kinds of item: an anchor, a route, or a reserved slot with no
// destination yet. The structure — order, kind, target — is data declared once and
// consumed here; this file only turns that data into markup and decides which item,
// if any, is the one the visitor is already on.
import { NAV_ITEMS, NO_NAV_HREF, resolveNavItemHref } from '../../../lib/nav/nav-structure.mjs';

interface NavLabels {
  work: string;
  about: string;
  experience: string;
  contact: string;
  writing: string;
  architectures: string;
  search: string;
  soon_tag: string;
}

interface Props {
  lang: 'en' | 'es';
  isIndexPage: boolean;
  currentSlug: string;
  nav: NavLabels;
  currentSectionKey?: string;
}

const { lang, isIndexPage, currentSlug, nav, currentSectionKey } = Astro.props;
---

<ul class="site-rail__nav" data-spy="site-rail__nav-item--current">
  {
    NAV_ITEMS.map((item) => {
      const href = resolveNavItemHref(item, { lang, isIndexPage });
      // Current either because this item IS the page, or because the page sits inside
      // the section it names — an article is not a nav destination but is read from
      // inside one, and the rail says so.
      const isCurrent =
        (item.kind === 'route' && item.slug === currentSlug) ||
        (currentSectionKey !== undefined && item.key === currentSectionKey);
      const label = nav[item.key as keyof NavLabels];
      return (
        <li class:list={['site-rail__nav-item', { 'site-rail__nav-item--current': isCurrent }]}>
          {href === NO_NAV_HREF ? (
            <span class="site-rail__nav-item-label">
              <span class="site-rail__nav-indicator" aria-hidden="true" />
              {label}
              <span class="site-rail__nav-tag">{nav.soon_tag}</span>
            </span>
          ) : (
            <a class="site-rail__nav-link" href={href} aria-current={isCurrent ? 'page' : undefined}>
              <span class="site-rail__nav-indicator" aria-hidden="true" />
              {label}
            </a>
          )}
        </li>
      );
    })
  }
</ul>

<style>
  .site-rail__nav {
    list-style: none;
    margin: 40px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .site-rail__nav-item {
    display: flex;
  }
  .site-rail__nav-link,
  .site-rail__nav-item-label {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: 1 1 auto;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 600;
    padding: 9px 0;
    color: var(--color-ink-muted);
    transition: color 0.14s ease;
  }
  .site-rail__nav-item-label {
    color: var(--color-ink-faint);
    cursor: default;
  }
  .site-rail__nav-link:hover {
    color: var(--color-ink);
  }
  .site-rail__nav-link:hover .site-rail__nav-indicator {
    width: 26px;
    background: var(--color-ink);
  }
  .site-rail__nav-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
    border-radius: 2px;
  }
  .site-rail__nav-item--current .site-rail__nav-link {
    color: var(--color-ink);
  }
  .site-rail__nav-item--current .site-rail__nav-indicator {
    width: 26px;
    background: var(--color-accent);
  }
  .site-rail__nav-indicator {
    width: 14px;
    height: 1px;
    background: var(--color-border-strong);
    flex: 0 0 auto;
    transition:
      width 0.18s ease,
      background 0.18s ease;
  }
  .site-rail__nav-tag {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
  }

  @media (max-width: 820px) {
    .site-rail__nav {
      margin: 0;
      flex-direction: row;
      gap: 18px;
      flex: 1 1 auto;
      overflow-x: auto;
      scrollbar-width: none;
      padding-bottom: 2px;
    }
    .site-rail__nav::-webkit-scrollbar {
      display: none;
    }
    .site-rail__nav-link,
    .site-rail__nav-item-label {
      padding: 4px 0;
      white-space: nowrap;
      font-size: 13.5px;
    }
    .site-rail__nav-indicator,
    .site-rail__nav-tag {
      display: none;
    }
    .site-rail__nav-item--current .site-rail__nav-link {
      color: var(--color-accent);
    }
  }
</style>
