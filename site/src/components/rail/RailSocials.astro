---
interface SocialLink {
  name: string;
  url: string;
}

interface Props {
  socials: SocialLink[];
}

const { socials } = Astro.props;
---

{socials.length > 0 && (
  <ul class="site-rail__socials">
    {socials.map((social) => (
      <li class="site-rail__socials-item">
        <a class="site-rail__socials-link" href={social.url}>{social.name}</a>
      </li>
    ))}
  </ul>
)}

<style>
  .site-rail__socials {
    display: flex;
    align-items: center;
    gap: 10px;
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.03em;
  }
  .site-rail__socials-item {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .site-rail__socials-item:not(:first-child)::before {
    content: '·';
    color: var(--color-border-strong);
  }
  .site-rail__socials-link {
    color: var(--color-ink-faint);
  }
  .site-rail__socials-link:hover {
    color: var(--color-accent);
  }
  .site-rail__socials-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
    border-radius: 2px;
  }

  @media (max-width: 820px) {
    .site-rail__socials {
      display: none;
    }
  }
</style>
