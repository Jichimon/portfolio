---
// One photograph, in one of the two shapes the page uses.
//
// <Picture> rather than <Image>, and that is a correctness choice rather than a stylistic
// one: <Image> accepts a formats array and silently ignores it, emitting a single format
// as one <img srcset>. A component written the obvious way would ship believing it had
// negotiated AVIF. <Picture> emits a <source> per format with the JPEG as the fallback.
//
// The widths come from the real measure this page is built on — a 680px column, and half
// of it for each of the paired figures — rather than from round numbers. Astro never
// upscales, so a width larger than the source simply yields the source.
import { Picture } from 'astro:assets';

interface Props {
  alt: string;
  image: ImageMetadata;
  shape: 'break' | 'pair';
  caption?: string;
}

const { alt, image, shape, caption } = Astro.props;

const WIDTHS_BY_SHAPE: Record<Props['shape'], number[]> = {
  break: [640, 960, 1280],
  pair: [340, 680, 1024],
};

// What the browser should assume the rendered box is, so it picks a candidate before
// layout rather than defaulting to the full viewport and over-fetching every time.
const SIZES_BY_SHAPE: Record<Props['shape'], string> = {
  break: '(max-width: 820px) 100vw, 1176px',
  pair: '(max-width: 560px) 100vw, (max-width: 820px) 50vw, 330px',
};
---

<figure class:list={['about-figure', `about-figure--${shape}`]}>
  <Picture
    class={`about-figure__image about-figure__image--${shape}`}
    src={image}
    alt={alt}
    widths={WIDTHS_BY_SHAPE[shape]}
    sizes={SIZES_BY_SHAPE[shape]}
    formats={['avif', 'webp']}
  />
  {caption && <figcaption class="about-figure__caption">{caption}</figcaption>}
</figure>

<style>
  .about-figure {
    margin: 56px 0;
  }

  /* The one full-width moment on the page, and the only element that leaves the column.
     The artboard specifies 21:9; this ships 3:2 because the photograph is 3:2 and cropping
     it would cost the sky and the foreground road that give the mountain its scale. A
     declared deviation, not a drift. */
  .about-figure--break {
    margin: 60px 0 64px;
  }
  .about-figure--pair {
    margin: 0;
  }

  .about-figure__image {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 4px;
  }
  .about-figure__image--break {
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }
  .about-figure__image--pair {
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .about-figure__caption {
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.6;
    color: var(--color-ink-faint);
    margin-top: 12px;
  }
  /* The wide figure breaks the column, but its caption does not: the caption belongs to
     the reading measure, so it returns to it. */
  .about-figure--break .about-figure__caption {
    max-width: 680px;
    margin-inline: auto;
  }
  .about-figure--pair .about-figure__caption {
    margin-top: 10px;
  }

  @media (max-width: 820px) {
    .about-figure--break {
      margin: 40px 0;
    }
    .about-figure--break .about-figure__caption {
      max-width: none;
    }
  }
</style>
