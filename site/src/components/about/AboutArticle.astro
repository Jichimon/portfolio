---
// The About page's body: masthead, the one full-width photograph the page allows,
// the rendered markdown, the paired photographs and the closing next-up links.
//
// The markdown pipeline wraps the rendered body in one `.about-article__prose-part`
// div when the author left no thematic break in it, or two when they put one in — and
// nothing here can tell which. So the paired-figure block is never inserted into the
// slot's markup; instead every prose part and the pair block are made flex children of
// one column-direction container and sorted by `order`, keyed off `:first-of-type` /
// `:nth-of-type(2)`. One part sorts before the pair, so the pair lands after the whole
// body; a second part (if the body has one) sorts after the pair, so the pair lands
// between the two halves. No branch ever asks how many parts there are.
import AboutPhotoFigure from './AboutPhotoFigure.astro';
import AboutByline from './AboutByline.astro';
import NextUp from '../page/NextUp.astro';

interface PhotoFigure {
  alt: string;
  image: ImageMetadata;
  caption?: string;
}

interface Props {
  masthead: { h1: string; since: string; readsAs: string; lead?: string };
  breakFigure?: PhotoFigure;
  pairFigures: PhotoFigure[];
  labels: {
    label: string;
    based_in: string;
    since: string;
    reads_as: string;
    next_up: { key: string; label: string }[];
  };
  location: string;
  lang: 'en' | 'es';
}

// The root is an article rather than a section, deliberately: the page shell gives
// every section inside it the page measure, and the page module already wraps this
// one. A second section here would apply that inset twice and indent the whole page
// against every other. An article is also the truer element for one self-contained
// composition.
const { masthead, breakFigure, pairFigures, labels, location, lang } = Astro.props;
---

<article class="about-article">
  <div class="about-article__col">
    <p class="about-article__label">{labels.label}</p>
    <h1 class="about-article__heading">{masthead.h1}</h1>
    {masthead.lead && <p class="about-article__lead">{masthead.lead}</p>}
    <AboutByline
      location={location}
      since={masthead.since}
      readsAs={masthead.readsAs}
      labels={{ based_in: labels.based_in, since: labels.since, reads_as: labels.reads_as }}
    />
  </div>

  {breakFigure && (
    <AboutPhotoFigure shape="break" alt={breakFigure.alt} image={breakFigure.image} caption={breakFigure.caption} />
  )}

  <div class="about-article__col">
    <div class="about-article__body">
      <slot />
      {pairFigures.length > 0 && (
        <div class="about-article__pair">
          {pairFigures.map((figure) => (
            <AboutPhotoFigure shape="pair" alt={figure.alt} image={figure.image} caption={figure.caption} />
          ))}
        </div>
      )}
    </div>

    <NextUp items={labels.next_up} lang={lang} variant="article" />
  </div>
</article>

<style>
  .about-article__col {
    max-width: 680px;
    margin-inline: auto;
  }

  .about-article__label {
    font: var(--type-label);
    letter-spacing: var(--type-label-tracking);
    text-transform: uppercase;
    color: var(--color-label);
    margin: 0 0 30px;
  }

  .about-article__heading {
    font: var(--type-display-l);
    line-height: 1.15;
    letter-spacing: -0.018em;
    margin: 0 0 26px;
  }

  .about-article__lead {
    font-size: 18px;
    line-height: 1.72;
    color: var(--color-ink-muted);
    margin: 0;
  }

  .about-article__body {
    display: flex;
    flex-direction: column;
  }

  /* The pipeline's own prose-part divs, sorted by position rather than by a count this
     template never sees — see the file banner. */
  .about-article__body :global(.about-article__prose-part:first-of-type) {
    order: -1;
  }
  .about-article__body :global(.about-article__prose-part:nth-of-type(2)) {
    order: 1;
  }

  .about-article__pair {
    order: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin: 56px 0;
  }

  /* The rendered body arrives as slot content, so it never carries this component's
     scope attribute — these rules stay narrowly nested under the one element that
     holds the slot rather than the whole block. */
  .about-article__body :global(p) {
    font-size: 17.5px;
    line-height: 1.8;
    color: var(--color-ink-muted);
    margin: 0 0 24px;
  }
  .about-article__body :global(p:last-child) {
    margin-bottom: 0;
  }
  .about-article__body :global(strong) {
    color: var(--color-ink);
    font-weight: 650;
  }
  .about-article__body :global(a) {
    color: var(--color-ink);
    border-bottom: 1px solid var(--color-accent-line);
    padding-bottom: 1px;
  }
  .about-article__body :global(a:hover) {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }
  .about-article__body :global(.about-article__drop) {
    font-size: 21px;
    line-height: 1.66;
    color: var(--color-ink);
  }
  .about-article__body :global(.about-article__pull) {
    font: var(--type-display-l);
    font-size: 28px;
    font-style: italic;
    line-height: 1.42;
    color: var(--color-ink);
    margin: 60px 0;
    padding-left: 24px;
    border-left: 2px solid var(--color-accent);
  }

  @media (max-width: 820px) {
    .about-article__col {
      max-width: none;
    }
    .about-article__heading {
      font-size: 30px;
    }
    .about-article__lead {
      font-size: 16.5px;
    }
    .about-article__body :global(p) {
      font-size: 16px;
      line-height: 1.75;
    }
    .about-article__body :global(.about-article__drop) {
      font-size: 18px;
    }
    .about-article__body :global(.about-article__pull) {
      font-size: 21px;
      margin: 40px 0;
      padding-left: 18px;
    }
  }

  @media (max-width: 560px) {
    .about-article__heading {
      font-size: 25px;
    }
    .about-article__pair {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
</style>
