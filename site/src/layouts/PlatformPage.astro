---
// The platform archetype. It differs from the case study in three deliberate places
// and nowhere else: the header carries a scale figure where a case study carries an
// outcome metric, the services list is drawn as a grid, and the children it names get
// a card grid at the foot. The services grid arrives already rebuilt by the content
// pipeline, so nothing in this file inspects the body.
import BaseLayout from './BaseLayout.astro';
import { SECTION_NAV_KEY_FOR_ARTICLES } from '../../lib/nav/nav-structure.mjs';
import TableOfContents from '../components/article/TableOfContents.astro';
import ArticleMasthead from '../components/article/ArticleMasthead.astro';
import ArticleBody from '../components/article/ArticleBody.astro';
import ScaleBlock from '../components/article/ScaleBlock.astro';
import SkillChips from '../components/article/SkillChips.astro';
import DeepDiveGrid from '../components/article/DeepDiveGrid.astro';

const {
  lang,
  entry,
  article,
  Content,
  tableOfContents,
  mastheadRows,
  deepDiveCards,
  deepDivesHeadingId,
  backHref,
  alternateHref,
  nav,
  rail,
  socials,
  footerText,
} = Astro.props;

const { title, subtitle, scale, scale_caption: scaleCaption, skills = [] } = entry.data;
---

<BaseLayout
  lang={lang}
  title={title}
  isIndexPage={false}
  currentSlug={entry.data.slug}
  nav={nav}
  rail={rail}
  socials={socials}
  alternateHref={alternateHref}
  footerText={footerText}
  currentSectionKey={SECTION_NAV_KEY_FOR_ARTICLES}
>
  <TableOfContents slot="rail-extra" label={article.toc_heading} entries={tableOfContents} />

  <section class="article">
    <a class="article__back-link" href={backHref}>{article.back_to_work}</a>

    <div class="article__header">
      <div class="article__header-main">
        <p class="article__tag">{article.platform_tag}</p>
        <h1 class="article__title">{title}</h1>
        {subtitle && <p class="article__subtitle">{subtitle}</p>}
      </div>
      {scale && <ScaleBlock figure={scale} caption={scaleCaption} />}
    </div>

    <ArticleMasthead rows={mastheadRows} />
    <ArticleBody content={Content} />
    <SkillChips skills={skills} />
    <DeepDiveGrid heading={article.deep_dives} headingId={deepDivesHeadingId} cards={deepDiveCards} />
  </section>
</BaseLayout>

<style>
  .article {
    padding-top: 64px;
    padding-bottom: 96px;
  }
  .article__back-link {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--color-ink-faint);
    display: inline-block;
    margin-bottom: 28px;
    text-decoration: none;
  }
  .article__back-link:hover {
    color: var(--color-accent);
  }
  /* The scale figure sits beside the title block and drops under it when there is no
     room. No rule beneath: the masthead below carries its own top border, and two
     stacked horizontal rules with a gap between them read as a mistake. */
  .article__header {
    display: flex;
    gap: 56px;
    align-items: flex-end;
    margin-bottom: 40px;
    flex-wrap: wrap;
  }
  .article__header-main {
    flex: 1 1 480px;
    min-width: 0;
  }
  .article__tag {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 16px;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0 0 16px;
  }
  .article__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 36px;
    line-height: 1.16;
    letter-spacing: -0.012em;
    margin: 0 0 12px;
  }
  .article__subtitle {
    font-size: 16px;
    line-height: 1.5;
    color: var(--color-ink-muted);
    max-width: 560px;
    margin: 0;
  }

  @media (max-width: 820px) {
    .article {
      padding-top: 36px;
      padding-bottom: 64px;
    }
    .article__header {
      gap: 24px;
    }
    .article__title {
      font-size: 28px;
    }
    .article__subtitle {
      font-size: 15.5px;
    }
  }

  @media (max-width: 560px) {
    .article {
      padding-inline: 18px;
    }
  }
</style>
