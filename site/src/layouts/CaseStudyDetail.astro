---
// The case-study archetype. One file for the type, never one per entry: everything on
// the page is derived from the entry it is handed, and nothing here knows which of the
// four case studies it is rendering.
import BaseLayout from './BaseLayout.astro';
import { SECTION_NAV_KEY_FOR_ARTICLES } from '../../lib/nav/nav-structure.mjs';
import TableOfContents from '../components/article/TableOfContents.astro';
import ArticleMasthead from '../components/article/ArticleMasthead.astro';
import ArticleBody from '../components/article/ArticleBody.astro';
import SkillChips from '../components/article/SkillChips.astro';

const {
  lang,
  entry,
  article,
  Content,
  tableOfContents,
  mastheadRows,
  parentClause,
  backHref,
  alternateHref,
  nav,
  rail,
  socials,
  footerText,
} = Astro.props;

const { title, subtitle, skills = [] } = entry.data;
---

<BaseLayout
  lang={lang}
  title={title}
  isIndexPage={false}
  currentSlug={entry.data.slug}
  nav={nav}
  rail={rail}
  socials={socials}
  alternateHref={alternateHref}
  footerText={footerText}
  currentSectionKey={SECTION_NAV_KEY_FOR_ARTICLES}
>
  <TableOfContents slot="rail-extra" label={article.toc_heading} entries={tableOfContents} />

  <section class="article">
    <a class="article__back-link" href={backHref}>{article.back_to_work}</a>

    <p class="article__tag">
      {article.case_study_tag}{parentClause && <Fragment> · {parentClause}</Fragment>}
    </p>
    <h1 class="article__title">{title}</h1>
    {subtitle && <p class="article__subtitle">{subtitle}</p>}

    <ArticleMasthead rows={mastheadRows} />
    <ArticleBody content={Content} />
    <SkillChips skills={skills} />
  </section>
</BaseLayout>

<style>
  .article {
    padding-top: 64px;
    padding-bottom: 96px;
  }
  .article__back-link {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--color-ink-faint);
    display: inline-block;
    margin-bottom: 28px;
    text-decoration: none;
  }
  .article__back-link:hover {
    color: var(--color-accent);
  }
  .article__tag {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 15px;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0 0 16px;
  }
  .article__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 38px;
    line-height: 1.16;
    letter-spacing: -0.012em;
    max-width: 780px;
    margin: 0 0 12px;
  }
  .article__subtitle {
    font-size: 17px;
    line-height: 1.5;
    color: var(--color-ink-muted);
    max-width: 660px;
    margin: 0 0 40px;
  }

  @media (max-width: 820px) {
    .article {
      padding-top: 36px;
      padding-bottom: 64px;
    }
    .article__title {
      font-size: 28px;
    }
    .article__subtitle {
      font-size: 15.5px;
    }
  }

  @media (max-width: 560px) {
    .article {
      padding-inline: 18px;
    }
  }
</style>
