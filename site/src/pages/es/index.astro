---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomeSections from '../../components/home/HomeSections.astro';
import { getPage, getUiStrings, getAlternateHref } from '../../gateway/content-queries.ts';

const lang = 'es';
const slug = 'home';

const [page, ui, alternateHref] = await Promise.all([
  getPage(slug, lang),
  getUiStrings(lang),
  getAlternateHref(slug, lang),
]);
---

<BaseLayout
  lang={lang}
  title={page.data.title}
  isIndexPage={true}
  currentSlug={slug}
  nav={ui.data.nav}
  rail={ui.data.rail}
  socials={ui.data.socials}
  alternateHref={alternateHref}
  footerText={ui.data.footer.metrics_slot}
>
  <HomeSections lang={lang} />
</BaseLayout>
